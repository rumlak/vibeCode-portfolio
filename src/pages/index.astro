---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import HomeContent, { frontmatter } from "../content/pages/home.md";

const {
	metaTitle,
	heroLine,
	heroSub,
	projectsPreviewTitle,
	projectsPreviewIntro,
	projects,
	newsletter,
} = frontmatter;
---
<BaseLayout title={metaTitle} description={heroSub}>
	<section class="hero">
		<h1>{heroLine}</h1>
		<p class="lead">{heroSub}</p>
	</section>

	<NewsletterForm
		id="home-newsletter"
		title={newsletter.title}
		body={newsletter.body}
		inputLabel={newsletter.inputLabel}
		inputPlaceholder={newsletter.inputPlaceholder}
		buttonText={newsletter.buttonText}
	/>

	<section class="projects-preview">
		<div class="section-head">
			<h2>{projectsPreviewTitle}</h2>
			<p>{projectsPreviewIntro}</p>
		</div>
		<div class="card-grid">
			{projects.map((project) => (
				<article class="card">
					<h3>{project.title}</h3>
					<p>{project.description}</p>
					<p class="outcome">{project.outcome}</p>
				</article>
			))}
		</div>
	</section>

	<section class="page-body">
		<HomeContent />
	</section>
</BaseLayout>
